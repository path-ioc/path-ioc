{
  "name": "path-ioc-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:all": "pnpm -r run build",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm --filter container-test-app run test && pnpm --filter full-test-app run test && pnpm --filter modules-merge-test-app run test && pnpm --filter full-test-app run build:vite && pnpm --filter full-test-app run build:webpack && pnpm --filter full-test-app run build:rspack && pnpm --filter modules-merge-test-app run build",
    "dev": "pnpm -r run dev",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "bench": "pnpm --filter @path-ioc/benchmarks run bench",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "docs:deploy": "pnpm --filter docs run deploy",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@swc/core": "^1.15.47",
    "@types/lodash-es": "^4.17.12",
    "swc-loader": "^0.2.7",
    "vitest": "^3.2.7",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  }
}
