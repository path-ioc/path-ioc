{
  "name": "path-ioc-monorepo",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:all": "pnpm -r run build",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm --filter container-test-app run test && pnpm --filter full-test-app run test && pnpm --filter full-test-app run build:vite && pnpm --filter modules-merge-test-app run test && pnpm --filter full-test-app run build:webpack && pnpm --filter full-test-app run build:rspack && pnpm --filter modules-merge-test-app run build",
    "dev": "pnpm -r run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "bench": "pnpm --filter @path-ioc/benchmarks run bench",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:preview": "pnpm --filter docs run preview",
    "docs:deploy": "pnpm --filter docs run deploy",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "swc-loader": "^0.2.7",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  }
}
